{
  "//": "dev2 edge: which TLS names the nginx stream proxy hands to Caddy, and what Caddy does with them. Rendered by dev2/dev2-edge. Every upstream is the one nginx used before the move (2026-10-19). Certificates are NOT issued by Caddy: caddy-edge-certs copies the files the existing renewals (certbot, pit-proxy-cert, moshpit-renew) already keep current, and reloads Caddy when they change.",
  "ports": { "nginx": 8444, "caddy": 8453, "caddy_http": 8454, "caddy_admin": 2019 },
  "caddy_version": "2.11.7",
  "stream_timeout": "24h",
  "nginx": { "worker_connections": 4096, "worker_rlimit_nofile": 16384 },
  "cert_sources": [
    { "dir": "/etc/letsencrypt/live/pit.world", "crt": "fullchain.pem", "key": "privkey.pem", "as": "pit.world" },
    { "dir": "/etc/nginx/pit-proxy-certs" },
    { "dir": "/etc/ssl/moshpit" },
    { "dir": "/etc/ssl/moshpit-riotcoder" },
    { "dir": "/etc/ssl/pwa-pit-world", "crt": "fullchain.pem", "key": "privkey.pem", "as": "wildcard.pwa.pit.world" }
  ],
  "keep_on_nginx": {
    "//": "Names under a routed pattern that stay on nginx for now, with why.",
    "live.streaming.pit.world": "per-path routing to two nixamp servers with a 404 fallback (error_page @server2); move after it has its own Caddy rehearsal",
    "webmail.pit.world": "Roundcube (dev2-site webmail.profullstack.com, :3391): an ordinary dev2-site vhost + HTTP-01 cert on nginx, not a pit-proxy name"
  },
  "sites": [
    { "hosts": ["pit.world"], "proxy": 8787, "max_body": "1MiB" },
    { "hosts": ["www.pit.world"], "redirect": "https://pit.world{uri}" },
    { "hosts": ["ad.network.pit.world"], "proxy": 8800, "max_body": "1MiB", "gzip": true },
    { "hosts": ["agent.database.pit.world"], "proxy": 18080, "max_body": "512KiB", "gzip": true, "access_log": true, "sanitize_query": true },
    { "hosts": ["otr.podcast.pit.world"], "proxy": 8787, "max_body": "30MiB", "gzip": true,
      "//": "preserve the legacy pit.world alias route while the exact OTR host uses port 8814" },
    { "hosts": ["auctions.pit.world", "art.auctions.pit.world"], "proxy": 8787, "max_body": "30MiB", "gzip": true,
      "//": "Art Auctions House: exact root and nested hosts served by pit.world" },
    { "hosts": ["group.call.pit.world"], "proxy": 8810, "max_body": "1MiB", "retry": "20s",
      "//": "group.call (moshcoder/group.call): no gzip, so the room page's server-sent events are not held back; retry holds Telnyx webhooks across a deploy instead of 502" },
    { "hosts": ["*.*.pit.world", "*.*.*.pit.world"], "proxy": 8787, "max_body": "30MiB", "gzip": true,
      "//": "pit-proxy: every <name>.pit.world (+ bbs./social.) relayed by the pit.world app; one Let's Encrypt certificate per name from pit-proxy-cert" },
    {"hosts": ["advis0r.pwa.pit.world"], "proxy": 3277, "max_body": "64MiB", "gzip": true, "//": "<name>.pwa.pit.world: apps whose ICANN domain is being let go (2026-11-08), served from the same dev2 containers so the domain can expire. One wildcard certificate (*.pwa.pit.world, acme.sh DNS-01) covers them all; -supabase hosts are the self-hosted Supabase gateways the browser code calls; c0upons-bbs serves the board at /bbs."},
    {"hosts": ["agenticjobs.pwa.pit.world"], "proxy": 3214, "max_body": "64MiB", "gzip": true},
