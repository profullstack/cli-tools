[Unit]
Description=c0mpute autoscale: stop rented GPU nodes while idle, start them on network demand
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# C0MPUTE_API_KEY (fleet key) for the dashboard report; provider keys are files under
# ~/.config/c0mpute/autoscale/ (0600), read by c0mpute itself.
EnvironmentFile=-%h/.config/c0mpute/autoscale/env
ExecStart=%h/.local/share/c0mpute-seed/bin/c0mpute autoscale run
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
