{
 "proxies": [
  {
   "host": "supabase.ugig.net",
   "port": 8249,
   "max_body": "512m"
  }
 ],
 "env_overrides": {
  "NEXT_PUBLIC_SUPABASE_URL": "https://supabase.ugig.net",
  "SUPABASE_DB_PASSWORD": "secret:SUPABASE_DB_PASSWORD",
  "NEXT_PUBLIC_SUPABASE_ANON_KEY": "secret:NEXT_PUBLIC_SUPABASE_ANON_KEY",
  "SUPABASE_SERVICE_ROLE_KEY": "secret:SUPABASE_SERVICE_ROLE_KEY"
 },
 "keep_services": [
  "realtime"
 ],
 "mem_limit": "1536m",
 "node_heap_mb": 0,
 "mem_note": "image sets NODE_OPTIONS=--max-old-space-size=1024"
}
